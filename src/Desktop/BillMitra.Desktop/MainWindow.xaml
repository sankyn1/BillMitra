<Window x:Class="BillMitra.Desktop.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:wv2="clr-namespace:Microsoft.Web.WebView2.Wpf;assembly=Microsoft.Web.WebView2.Wpf"
        mc:Ignorable="d"
        Title="BillMitra – GST Billing &amp; Inventory Management" 
        Height="820" Width="1300"
        MinHeight="700" MinWidth="1024"
        WindowStartupLocation="CenterScreen"
        Background="#0F172A">
    <Grid>
        <!-- Embedded WebView2 Browser -->
        <wv2:WebView2 x:Name="AppWebView" 
                      HorizontalAlignment="Stretch" 
                      VerticalAlignment="Stretch" 
                      Visibility="Hidden" />

        <!-- Initial Startup & Health Check Splash Overlay -->
        <Grid x:Name="SplashOverlay" Background="#0F172A">
            <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center">
                <TextBlock Text="BillMitra" 
                           FontSize="38" 
                           FontWeight="Bold" 
                           Foreground="#FFFFFF" 
                           HorizontalAlignment="Center" />
                <TextBlock Text="GST Billing, Inventory &amp; Business Management" 
                           FontSize="14" 
                           Foreground="#94A3B8" 
                           Margin="0,6,0,24" 
                           HorizontalAlignment="Center" />

                <ProgressBar x:Name="StartupProgress" 
                             IsIndeterminate="True" 
                             Width="260" 
                             Height="4" 
                             Foreground="#2563EB" 
                             Background="#1E293B" 
                             BorderThickness="0" />

                <TextBlock x:Name="StatusText" 
                           Text="Initializing local services..." 
                           FontSize="12" 
                           Foreground="#64748B" 
                           Margin="0,16,0,0" 
                           HorizontalAlignment="Center" />
            </StackPanel>
        </Grid>
    </Grid>
</Window>
